{% extends "layouts/app.twig" %}

{% block title %}
	Flashcard
{% endblock %}

{% block content %}
	{% include "components/header.twig" %}

	<main>
		<div class="w-full">
			<section class="grid gap-8 py-8 lg:grid-cols-[minmax(0,1fr)_20rem]" aria-label="Flashcard study area">
				<article>
					{% if flashcard %}
						{% include "components/flashcard.twig" with {
                            flashcard: flashcard,
                            position: position,
                            total: total,
    						hasPrevious: hasPrevious,
    						hasNext: hasNext
                    } only %}
					{% else %}
						<section class="
							rounded-3xl border border-dashed border-slate-300
						    bg-white p-12 text-center" 
                                aria-labelledby="empty-state-title">
							<h2 id="empty-state-title" class="text-2xl font-semibold text-slate-900">
								No flashcards available
							</h2>

							<p class="mt-3 text-slate-600">
								Add a flashcard to begin studying.
							</p>
						</section>
					{% endif %}
				</article>

				<aside aria-label="Study statistics">
					<h2 class="text-xl font-semibold text-slate-900">
						Statistics
					</h2>

					<p class="mt-2 text-slate-600">
						Your study progress will appear here.
					</p>
				</aside>
			</section>
		</div>
	</main>
{% endblock %}
